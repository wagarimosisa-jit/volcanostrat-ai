# Backend
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Frontend
REACT_APP_API_URL=http://localhost:8000

# =============================================================================
# GVAS AI Geologist — LLM Configuration (backend only, never expose to frontend)
# =============================================================================

# Enable/disable external LLM (geology KB + causal engine still work when false)
# Set to false to use geology-only mode (no LLM errors, causal engine + KB still work)
LLM_ENABLED=false

# Provider: auto | openai | anthropic | gemini | ollama
# auto = first configured provider in order: openai, anthropic, gemini, ollama
LLM_PROVIDER=auto

# --- OpenAI (ChatGPT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Google Gemini ---
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias for GOOGLE_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
